rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn()
        && userDoc().keys().hasAny(['approved'])
        && userDoc().approved == true;
    }

    function isAdmin() {
      return isApproved() && userDoc().role == 'admin';
    }

    function isAccountant() {
      return isApproved() && userDoc().role == 'accountant';
    }

    function isPlantHead() {
      return isApproved() && userDoc().role == 'plant_head';
    }

    // /users/{uid} — role field is the authorization source of truth
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == null
        && request.resource.data.approved == false;

      allow update: if isAdmin()
        || (isSelf(uid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'approved']));

      allow delete: if isAdmin();
    }

    // /po_uploads/{id} — written by Admin SDK from /api/po/save;
    // client rules allow approved plant roles to read for dashboards.
    match /po_uploads/{poId} {
      allow read: if isAdmin() || isAccountant() || isPlantHead();
      // Writes go through Firebase Admin SDK (API routes) — deny client writes
      allow write: if false;
    }

    function isStoreManager() {
      return isApproved() && userDoc().role == 'store_manager';
    }

    function canReadInventory() {
      return isAdmin() || isPlantHead() || isStoreManager();
    }

    // Inventory collections — Admin SDK writes; authenticated store roles may read.
    match /raw_materials/{code} {
      allow read: if canReadInventory();
      allow write: if false;
    }

    match /stock_movements/{id} {
      allow read: if canReadInventory();
      allow write: if false;
    }

    match /inventory_uploads/{id} {
      allow read: if canReadInventory();
      allow write: if false;
    }

    // Parts / customers masters — Admin SDK writes; approved roles may read.
    match /parts/{itemCode} {
      allow read: if isAdmin() || isAccountant() || isPlantHead() || isStoreManager();
      allow write: if false;
    }

    match /customers/{code} {
      allow read: if isAdmin() || isAccountant() || isPlantHead();
      allow write: if false;
    }

    function isProductionHead() {
      return isApproved() && userDoc().role == 'production_head';
    }

    function canReadDispatch() {
      return isAdmin() || isAccountant() || isPlantHead()
        || isStoreManager() || isProductionHead();
    }

    // Dispatch collections — Admin SDK writes; approved ops roles may read.
    match /dispatch_uploads/{id} {
      allow read: if canReadDispatch();
      allow write: if false;
    }

    match /dispatches/{id} {
      allow read: if canReadDispatch();
      allow write: if false;
    }

    function canReadReconciliation() {
      return isAdmin() || isPlantHead() || isStoreManager() || isProductionHead();
    }

    // Reconciliation reports — Admin SDK writes; approved ops roles may read.
    match /reconciliation_reports/{id} {
      allow read: if canReadReconciliation();
      allow write: if false;
    }
  }
}
