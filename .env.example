# App environment — set to "development" to auto-seed demo users on startup
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ps-industries-b10f1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (server only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=ps-industries-b10f1
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines, or wrap in quotes with real newlines
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Session JWT (httpOnly cookie) — min 32 characters
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional: separate secret for invite JWTs (falls back to SESSION_SECRET)
# INVITE_TOKEN_SECRET=replace-with-another-long-random-secret-at-least-32-chars

# Optional: protect POST /api/auth/seed when no admin session exists yet
SEED_SECRET=replace-with-another-long-random-secret

# Resend (production invites). Without this, invite links are returned in the
# API response when NEXT_PUBLIC_ENV=development.
# RESEND_API_KEY=re_xxxxxxxx
# INVITE_EMAIL_FROM=PS Industries PMS <noreply@your-domain.com>
